#include <iostream>
using namespace std;

int main() {
    int v1[3], v2[3], v3[3], soma[3];

    // Leitura do primeiro vetor
    cout << "Digite os 3 valores do vetor 1:\n";
    for (int i = 0; i < 3; i++)
        cin >> v1[i];

    // Leitura do segundo vetor
    cout << "Digite os 3 valores do vetor 2:\n";
    for (int i = 0; i < 3; i++)
        cin >> v2[i];

    // Leitura do terceiro vetor
    cout << "Digite os 3 valores do vetor 3:\n";
    for (int i = 0; i < 3; i++)
        cin >> v3[i];

    // Soma dos vetores
    for (int i = 0; i < 3; i++)
        soma[i] = v1[i] + v2[i] + v3[i];

    // Exibição do vetor soma
    cout << "\nVetor resultado da soma:\n";
    for (int i = 0; i < 3; i++)
        cout << soma[i] << " ";

    cout << endl;
    return 0;
}

#include <iostream>
using namespace std;

int main() {
    int A[3], B[3], D[3];

    // Leitura do vetor A
    cout << "Digite os 3 valores do vetor A:\n";
    for (int i = 0; i < 3; i++) {
        cin >> A[i];
    }

    // Leitura do vetor B
    cout << "Digite os 3 valores do vetor B:\n";
    for (int i = 0; i < 3; i++) {
        cin >> B[i];
    }

    // Cálculo do vetor D = A - B
    for (int i = 0; i < 3; i++) {
        D[i] = A[i] - B[i];
    }

    // Exibição do vetor D
    cout << "\nVetor D (A - B): ";
    for (int i = 0; i < 3; i++) {
        cout << D[i] << " ";
    }

    cout << endl;
    return 0;
}





#include <iostream>
using namespace std;

int main() {
    int A[3], B[3];
    int produto_escalar = 0;

    // Leitura do vetor A
    cout << "Digite 3 valores para o vetor A:\n";
    for (int i = 0; i < 3; i++) {
        cin >> A[i];
    }

    // Leitura do vetor B
    cout << "Digite 3 valores para o vetor B:\n";
    for (int i = 0; i < 3; i++) {
        cin >> B[i];
    }

    // Cálculo do produto escalar
    for (int i = 0; i < 3; i++) {
        produto_escalar += A[i] * B[i];
    }

    // Exibição do resultado
    cout << "\nProduto escalar = " << produto_escalar << endl;

    return 0;
}


